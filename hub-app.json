{
  "id": "social-space",
  "name": "Social Space",
  "kind": "external",
  "version": "0.3.1",
  "identifier": "com.socialmanager.desktop",
  "versionFiles": [
    "package.json",
    "package-lock.json",
    "src-tauri/tauri.conf.json",
    "src-tauri/Cargo.toml",
    "src-tauri/Cargo.lock"
  ],
  "test": "npm ci && npm run typecheck && npm test && cd src-tauri && cargo test --locked",
  "build": "npm ci && npm run tauri:build",
  "artifact": "src-tauri/target/release/bundle/nsis/Social Space_{version}_x64-setup.exe",
  "launch": "%LOCALAPPDATA%\\Social Space\\social-manager.exe --hub",
  "update": {
    "version": "social-manager.exe --version --json",
    "check": "social-manager.exe --update check --json",
    "apply": "social-manager.exe --update apply --json",
    "rollback": "social-manager.exe --update rollback --json"
  }
}
