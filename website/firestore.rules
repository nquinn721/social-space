rules_version = '2';

// Social Space writes everything with its service account, which skips these rules.
// People signed in on the review site can only read, and only if their email is on the reviewers list.
// A reviewer's one write is the decision on a post that is still waiting: approve or reject, with a note.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInEmail() {
      return request.auth.token.email.lower();
    }
    function reviewer() {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/reviewers/$(signedInEmail()));
    }

    match /reviewers/{email} {
      allow read: if reviewer();
    }

    match /posts/{postId} {
      allow read: if reviewer();
      allow update: if reviewer()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedBy', 'decidedAt', 'note'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.decidedBy == signedInEmail()
        && request.resource.data.decidedAt is number
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000;
    }
  }
}
