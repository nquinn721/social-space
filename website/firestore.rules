rules_version = '2';

// Social Space writes everything with its service account, which skips these rules.
// People signed in on the review site can only read, and only if their email is on the reviewers list.
// A reviewer's one write is the decision on a post that is still waiting: approve or reject, with a note.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInEmail() {
      return request.auth.token.email.lower();
    }
    function reviewer() {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/reviewers/$(signedInEmail()));
    }

    match /reviewers/{email} {
      allow read: if reviewer();
    }

    // The brands and categories a reviewer can make a video for, kept up to date by Social Space.
    match /catalog/{doc} {
      allow read: if reviewer();
    }

    match /posts/{postId} {
      allow read: if reviewer();
      // A reviewer's own new video. Social Space downloads it into the brand's category and it then
      // waits for approval like any other post.
      allow create: if reviewer()
        && postId.matches('^[A-Za-z0-9_-]{8,128}$')
        && request.resource.data.keys().hasOnly(['videoId', 'source', 'createdBy', 'brandId', 'categoryId', 'brand', 'category',
             'title', 'youtubeTitle', 'description', 'hashtags', 'platforms', 'madeWithAi', 'coverMs', 'mediaPath', 'mediaUrl',
             'status', 'submittedAt', 'results', 'events'])
        && request.resource.data.videoId == postId
        && request.resource.data.source == 'partner'
        && request.resource.data.createdBy == signedInEmail()
        && request.resource.data.status == 'pending'
        && request.resource.data.mediaPath.matches('^uploads/' + request.auth.uid + '/.+')
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
        && request.resource.data.description is string && request.resource.data.description.size() <= 5000
        && request.resource.data.hashtags is list && request.resource.data.hashtags.size() <= 60
        && request.resource.data.platforms is list && request.resource.data.platforms.size() > 0
        && request.resource.data.submittedAt is number;
      allow update: if reviewer()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedBy', 'decidedAt', 'note'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.decidedBy == signedInEmail()
        && request.resource.data.decidedAt is number
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000;
    }
  }
}
