{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Allow the main window to use the desktop core.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-load-workspace", "allow-save-workspace", "allow-open-platform-action",
    "allow-open-kling", "allow-open-kling-developer", "allow-kling-key-status",
    "allow-save-kling-key", "allow-remove-kling-key", "allow-generate-kling-video",
    "allow-get-kling-video", "allow-open-kling-video", "allow-connect-x",
    "allow-x-connection", "allow-disconnect-x", "allow-post-to-x",
    "allow-connect-instagram", "allow-instagram-connection", "allow-disconnect-instagram", "allow-publish-instagram-reel",
    "allow-list-queue", "allow-add-queue-job", "allow-complete-queue-job", "allow-delete-queue-job", "allow-choose-video-file",
    "allow-check-for-update", "allow-install-update"
  ]
